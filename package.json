{
  "name": "whisper",
  "version": "1.0.0",
  "description": "Anonymous secrets board with real authentication: bcrypt, Postgres-backed sessions, Passport (local + Google OAuth), CSRF tokens and rate limiting.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1"
  }
}
