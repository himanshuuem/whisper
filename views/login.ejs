<%- include("partials/head", { title: "Log in" }) %>
<section class="auth-card">
  <h1>Welcome back</h1>
  <% if (typeof error !== "undefined" && error) { %><div class="alert" role="alert"><p><%= error %></p></div><% } %>
  <form method="post" action="/login" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Email <input type="email" name="email" value="<%= email %>" required autocomplete="email"></label>
    <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
    <button type="submit" class="btn">Log in</button>
  </form>
  <% if (googleEnabled) { %><a class="btn google" href="/auth/google">Continue with Google</a><% } %>
  <p class="switch">New here? <a href="/register">Create an account</a></p>
</section>
<%- include("partials/foot") %>
